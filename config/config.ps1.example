# ═══════════════════════════════════════════════════════════════
#  FISHELL: Configuração do usuário (Windows / PowerShell)
#  Copie este arquivo para `config.ps1` e edite os valores abaixo.
#
#      Copy-Item config\config.ps1.example config.ps1
#      notepad config.ps1
#
#  O arquivo `config.ps1` é ignorado pelo Git (nunca é commitado).
# ═══════════════════════════════════════════════════════════════

# Seu usuário do NPAD (obrigatório)
$NPAD_USER = 'seu_usuario_aqui'

# Host e porta do NPAD (normalmente não precisa mudar)
$NPAD_HOST = 'sc2.npad.ufrn.br'
$NPAD_PORT = '4422'

# Pasta onde estão as chaves SSH (id_rsa, id_rsa.pub, known_hosts).
#
# Padrão: a pasta `.ssh` do próprio fishell, que já vem no clone, vazia.
# Copie suas chaves para lá, ou troque o caminho abaixo.
$SSH_KEYS_DIR = "$RepoRoot\.ssh"

# Alternativas, use no lugar da linha acima:
#
#   $SSH_KEYS_DIR = "$HOME\.ssh"    # onde o ssh-keygen salva por padrão
#   $SSH_KEYS_DIR = 'D:\chaves\.ssh'  # caminho completo, qualquer lugar
#   $SSH_KEYS_DIR = ''              # deixa o fishell procurar sozinho
#
# Mudou este caminho? Rode `bin\fishell.cmd setup` de novo: é ele quem
# instala as chaves no ~/.ssh, que é onde o ssh vai procurar.

# Alias SSH usado no comando `ssh <alias>` (padrão: npad)
$SSH_ALIAS = 'npad'

# Idioma da interface: 'pt' (padrão) ou 'en'.
# A variável de ambiente FISHELL_LANG sobrescreve isto, e a tecla [l] do
# menu troca durante a sessão.
$FISHELL_LANG = 'pt'
